# Supabase Configuration
# CRITICAL: Replace these values with your actual Supabase project credentials
# You can find these in your Supabase project dashboard under Settings > API
# 
# SECURITY WARNING: Never commit actual credentials to version control
# Always use environment-specific .env files

# Example format (replace with your actual values):
VITE_SUPABASE_URL=https://pvmavjwogsryhhvkcdxu.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB2bWF2andvZ3NyeWhodmtjZHh1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTc5NTk2NDgsImV4cCI6MjA3MzUzNTY0OH0.EPmEJi4JW2vrQNYyJFkjhex5VlxID2Wz45KaeAky9FU

# Service Role Key (CRITICAL SECURITY)
# This key bypasses Row Level Security and should NEVER be exposed to client-side code
# Only use for server-side operations, Edge Functions, or development seeding
# In production, this should only be available to backend services
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# 
# NOTE: Service role key is OPTIONAL for basic operations
# The application will work without it using regular authentication
# Only add this if you need admin-level database operations

# Database Configuration
# Connection timeout in milliseconds (default: 30000 = 30 seconds)
VITE_DB_TIMEOUT=30000

# Maximum retry attempts for failed database operations (default: 3)
VITE_DB_MAX_RETRIES=3

# Connection monitoring interval in milliseconds (default: 30000 = 30 seconds)
VITE_DB_MONITOR_INTERVAL=30000

# Authentication Mode Configuration
# Controls whether the app uses development role selector or production authentication
# Values: "development" | "production"
# Default: "development" for testing, change to "production" for live deployment
VITE_AUTH_MODE=development

# Development Mode Settings
# When VITE_AUTH_MODE=development, users can select roles without credentials
# When VITE_AUTH_MODE=production, full authentication is required
VITE_ENABLE_ROLE_SELECTOR=true

# Session Configuration
# Maximum session duration in minutes (default: 480 = 8 hours)
VITE_SESSION_TIMEOUT=480

# Security Settings
# Maximum login attempts before account lockout
VITE_MAX_LOGIN_ATTEMPTS=5

# Database Health Monitoring
# Enable automatic database health monitoring (default: true)
VITE_ENABLE_DB_MONITORING=true

# Performance Monitoring
# Log slow queries (queries taking longer than this threshold in ms)
VITE_SLOW_QUERY_THRESHOLD=2000

# Error Reporting
# Enable detailed error logging for database operations (default: true in development)
VITE_ENABLE_DB_ERROR_LOGGING=true

# Instructions:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (or create a new one)
# 3. Go to Settings > API
# 4. Copy the "Project URL" and paste it as VITE_SUPABASE_URL
# 5. Copy the "anon public" key and paste it as VITE_SUPABASE_ANON_KEY
# 6. (Optional) Copy the "service_role" key for admin operations
# 7. Configure VITE_AUTH_MODE based on your deployment environment
# 8. Adjust database and performance settings as needed
# 9. Save this file as .env (remove the .example extension)
# 10. Restart your development server after making changes
#
# VALIDATION:
# - VITE_SUPABASE_URL must start with https:// and contain supabase.co
# - VITE_SUPABASE_ANON_KEY must be a valid JWT token (starts with eyJ)
# - All timeout values should be reasonable (1000-60000 ms)
# - Service role key should only be used for admin operations